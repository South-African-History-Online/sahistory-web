{#
/**
 * @file
 * Theme implementation for SAHO upcoming events block.
 *
 * Open Record 2027 idiom: archive index cards on paper with the event
 * accent edge (--type-event), duotone imagery, mono status/date meta and
 * display-font titles.
 *
 * JS hooks preserved (upcoming-events.js): .event-card-clickable (whole
 * card click + keyboard support) and .event-card__button (href source).
 */
#}
<div class="saho-upcoming-events-block saho-uev">
  {# Title is handled by Drupal's standard block title system #}

  {% if events %}
    <div class="saho-uev__grid">
      {% for event in events %}
        {# Status and "when" come from template_preprocess_saho_upcoming_events_block(), in SA time. #}
        {% set meta = event_meta[event.id()] %}
        {% set event_status_local = meta.status %}
        {% set event_status_label_local = meta.label %}
        {% set show_pulse_local = meta.pulse %}

        <article class="saho-uev__card event-card-clickable saho-uev__card--{{ event_status_local }}">

          {% if config.show_images and event.field_upcomingevent_image.0 and event.field_upcomingevent_image.entity %}
            <div class="saho-uev__media saho-duotone">
              <img src="{{ file_url(event.field_upcomingevent_image.entity.uri.value) }}"
                   alt="{{ event.field_upcomingevent_image.alt|default(event.getTitle()) }}"
                   class="saho-uev__img"
                   loading="lazy"
                   decoding="async">
            </div>
          {% endif %}

          <div class="saho-uev__body">
            <p class="saho-uev__status saho-uev__status--{{ event_status_local }}">
              {%- if show_pulse_local %}<span class="saho-uev__pulse" aria-hidden="true"></span>{% endif -%}
              {{ event_status_label_local }}
            </p>

            <h3 class="saho-uev__title">
              <a href="{{ path('entity.node.canonical', {'node': event.id()}) }}">{{ event.getTitle() }}</a>
            </h3>

            <div class="saho-uev__meta">
              {% if meta.when %}
                <span class="saho-uev__date">{{ meta.when }}</span>
              {% endif %}
                  {% else %}
                    {{ event.field_start_date.value|date('j F Y, H:i') }}
                  {% endif %}
                </span>
              {% endif %}

              {% if config.show_venue and event.field_upcoming_venue.value %}
                <span class="saho-uev__venue">{{ event.field_upcoming_venue.value|striptags }}</span>
              {% endif %}
            </div>

            {% if config.show_excerpt and event.body.value %}
              <p class="saho-uev__excerpt">
                {{ event.body.value|striptags|slice(0, config.excerpt_length) }}{% if event.body.value|striptags|length > config.excerpt_length %}...{% endif %}
              </p>
            {% endif %}

            <a href="{{ path('entity.node.canonical', {'node': event.id()}) }}" class="event-card__button saho-uev__more">
              View event record
              <span class="event-card__button-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if config.show_view_all_link %}
      <div class="view-all-events saho-uev__viewall-row">
        <a href="/all-upcoming-events" class="saho-uev__viewall">
          View all upcoming events <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {% endif %}
  {% else %}
    <div class="no-events-message">
      <p>{{ 'No upcoming events scheduled at this time.'|t }}</p>
    </div>
  {% endif %}
</div>
