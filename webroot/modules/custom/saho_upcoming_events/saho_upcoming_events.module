<?php

/**
 * @file
 * Primary module hooks for SAHO Upcoming Events module.
 */

use Drupal\node\NodeInterface;

/**
 * The timezone every public event time is shown in.
 */
const SAHO_UPCOMING_EVENTS_TIMEZONE = 'Africa/Johannesburg';

/**
 * Implements hook_help().
 */
function saho_upcoming_events_help($route_name) {
  switch ($route_name) {
    case 'help.page.saho_upcoming_events':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The SAHO Upcoming Events module provides functionality to display upcoming events on the front page.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_theme().
 */
function saho_upcoming_events_theme() {
  return [
    'saho_upcoming_events_block' => [
      'variables' => [
        'events' => [],
        'config' => [],
      ],
      'template' => 'saho-upcoming-events-block',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for the upcoming events block.
 *
 * Status and "when" per card, computed in South African time from the UTC
 * storage value. The template used to run the raw storage string through
 * Twig's date filter, which treats it as local time and so printed UTC.
 */
function template_preprocess_saho_upcoming_events_block(array &$variables): void {
  $variables['event_meta'] = [];
  foreach ($variables['events'] as $event) {
    if ($event instanceof NodeInterface) {
      $variables['event_meta'][$event->id()] = saho_upcoming_events_card_meta($event);
    }
  }
}

/**
 * Past, happening now or upcoming - the one rule for the whole site.
 *
 * Used by the event page (theme), the teaser, the home-page block (both
 * its query filter and its cards) and the /all-upcoming-events split, so
 * no two surfaces can disagree. Days are South African calendar days: an
 * event is "happening now" from its start day to its end day inclusive,
 * which includes an event that starts later today.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The upcomingevent node.
 * @param \DateTimeInterface|null $today
 *   The day to judge against (SA time); defaults to today. Tests pass one.
 *
 * @return array
 *   status (past | in-progress | upcoming), label, pulse (bool),
 *   days_until (int, upcoming only, else NULL), start and end as
 *   \DateTime in SA time (NULL when missing; start NULL = no date).
 */
function saho_upcoming_events_status(NodeInterface $node, ?\DateTimeInterface $today = NULL): array {
  $status = [
    'status' => 'past',
    'label' => 'Past event',
    'pulse' => FALSE,
    'days_until' => NULL,
    'start' => NULL,
    'end' => NULL,
  ];
  $start = saho_upcoming_events_local_date($node, 'field_start_date');
  if (!$start) {
    return $status;
  }
  $end = saho_upcoming_events_local_date($node, 'field_end_date');
  $status['start'] = $start;
  $status['end'] = $end;

  $tz = new \DateTimeZone(SAHO_UPCOMING_EVENTS_TIMEZONE);
  $today = $today ? new \DateTime($today->format('Y-m-d'), $tz) : new \DateTime('today', $tz);
  $start_day = new \DateTime($start->format('Y-m-d'), $tz);
  $end_day = new \DateTime(($end ?? $start)->format('Y-m-d'), $tz);

  if ($start_day <= $today && $end_day >= $today) {
    $status['status'] = 'in-progress';
    $status['label'] = 'Happening now';
    $status['pulse'] = TRUE;
  }
  elseif ($start_day > $today) {
    $days = (int) $today->diff($start_day)->format('%a');
    $status['status'] = 'upcoming';
    $status['days_until'] = $days;
    $status['label'] = match (TRUE) {
      $days === 1 => 'Tomorrow',
      $days <= 7 => "In $days days",
      default => 'Upcoming',
    };
  }
  return $status;
}

/**
 * Status plus the one-line "when" for an event card, in SA time.
 *
 * Shared by the home-page block and the listing teaser.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The upcomingevent node.
 * @param \DateTimeInterface|null $today
 *   See saho_upcoming_events_status().
 *
 * @return array
 *   Keys: status, label, pulse, when (empty when there is no start date).
 */
function saho_upcoming_events_card_meta(NodeInterface $node, ?\DateTimeInterface $today = NULL): array {
  $status = saho_upcoming_events_status($node, $today);
  $meta = [
    'status' => $status['status'],
    'label' => $status['label'],
    'pulse' => $status['pulse'],
    'when' => '',
  ];
  $start = $status['start'];
  $end = $status['end'];
  if (!$start) {
    return $meta;
  }
  if (!$end) {
    $meta['when'] = $start->format('j F Y, H:i');
  }
  elseif ($start->format('Y-m-d') === $end->format('Y-m-d')) {
    $meta['when'] = $start->format('j F Y, H:i') . ' - ' . $end->format('H:i');
  }
  else {
    $meta['when'] = $start->format('j F Y, H:i') . ' - ' . $end->format('j F Y, H:i');
  }
  return $meta;
}

/**
 * A datetime field value as a \DateTime in South African time, or NULL.
 *
 * Datetime fields store UTC strings; the computed ->date is a UTC
 * DrupalDateTime, cloned here so the field item is left untouched.
 */
function saho_upcoming_events_local_date(NodeInterface $node, string $field): ?\DateTime {
  if (!$node->hasField($field) || $node->get($field)->isEmpty()) {
    return NULL;
  }
  // @phpstan-ignore-next-line
  $date = $node->get($field)->date;
  if (!$date) {
    return NULL;
  }
  $local = clone $date->getPhpDateTime();
  $local->setTimezone(new \DateTimeZone(SAHO_UPCOMING_EVENTS_TIMEZONE));
  return $local;
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function saho_upcoming_events_preprocess_views_view(&$variables) {
  $view = $variables['view'];

  // Add CSS for all upcoming events view.
  if ($view->id() == 'all_upcoming_events') {
    $variables['#attached']['library'][] = 'saho_upcoming_events/upcoming_events';

    // Separate events into upcoming and past.
    // Use start of today in SAST timezone for comparison.
    $current_date = new \DateTime('today', new \DateTimeZone('Africa/Johannesburg'));
    $upcoming_events = [];
    $past_events = [];

    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    $renderer = \Drupal::service('renderer');

    foreach ($view->result as $row) {
      $node = $row->_entity;
      if (!$node) {
        continue;
      }
      // Same status rule as the block and the event page.
      $status = saho_upcoming_events_status($node, $current_date);
      if (!$status['start']) {
        continue;
      }
      $build = $view_builder->view($node, 'teaser');
      $event_data = [
        'timestamp' => $status['start']->getTimestamp(),
        'is_happening_now' => $status['status'] === 'in-progress',
        'markup' => ['#markup' => $renderer->render($build)],
      ];
      if ($status['status'] === 'past') {
        $past_events[] = $event_data;
      }
      else {
        $upcoming_events[] = $event_data;
      }
    }

    // Sort upcoming events: happening now first, then by start date.
    usort($upcoming_events, function ($a, $b) {
      // Happening now events come first.
      if ($a['is_happening_now'] && !$b['is_happening_now']) {
        return -1;
      }
      if (!$a['is_happening_now'] && $b['is_happening_now']) {
        return 1;
      }
      // Within same category, sort by start date.
      return $a['timestamp'] <=> $b['timestamp'];
    });

    // Sort past events reverse chronologically (most recent first).
    usort($past_events, function ($a, $b) {
      return $b['timestamp'] <=> $a['timestamp'];
    });

    // Extract just the markup for rendering.
    $upcoming_rows = array_column($upcoming_events, 'markup');
    $past_rows = array_column($past_events, 'markup');

    $variables['upcoming_events'] = $upcoming_rows;
    $variables['past_events'] = $past_rows;
    $variables['has_upcoming'] = !empty($upcoming_rows);
    $variables['has_past'] = !empty($past_rows);
  }
}

/**
 * Badge logic is handled by theme preprocess.
 *
 * Note: Badge variables (event_status, event_status_label, event_badge_variant,
 * show_pulse, countdown) are set by saho_preprocess_node__upcomingevent()
 * in saho.theme. This ensures consistent badge rendering across all view modes.
 */
