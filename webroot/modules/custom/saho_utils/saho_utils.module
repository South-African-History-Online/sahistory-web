<?php

/**
 * @file
 * Contains saho_utils.module.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\file\FileInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_form_alter().
 */
function saho_utils_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Alter the exposed form for the SAHO global search view.
  if ($form_id == 'views_exposed_form' && isset($form['#id']) && $form['#id'] == 'views-exposed-form-saho-global-search-page-1') {
    // Customize the fulltext search field options to rename body/title labels.
    if (isset($form['search_api_fulltext_searched_fields']) && isset($form['search_api_fulltext_searched_fields']['#options'])) {
      $options = &$form['search_api_fulltext_searched_fields']['#options'];

      // Replace the field labels with custom names.
      if (isset($options['body'])) {
        $options['body'] = t('Flexible Search');
      }
      if (isset($options['title'])) {
        $options['title'] = t('Strict Search');
      }
    }
  }

  // Archive browse (/archives) refine rail.
  if ($form_id == 'views_exposed_form' && isset($form['#id']) && $form['#id'] == 'views-exposed-form-saho-archive-search-page-1') {
    _saho_utils_archive_refine_alter($form);
  }

  // Extend the year range for event date field to support historical dates.
  // SAHO covers African history from earliest times to present.
  if ($form_id === 'node_event_form' || $form_id === 'node_event_edit_form') {
    if (isset($form['field_event_date']['widget'][0]['value'])) {
      // Allow dates from year 1000 to 2100 for historical events.
      // Note: Year must be 4 digits for Drupal's date range parser.
      $form['field_event_date']['widget'][0]['value']['#date_year_range'] = '1000:2100';
    }
  }
}

/**
 * Shapes the /archives refine rail on the Solr-backed archive view.
 *
 * The facets_exposed_filters options arrive as "Label (123)" with live,
 * selection-narrowed Solr counts, ordered count-descending with
 * zero-result values already dropped (min_count 1). This alter only
 * restyles: counts move into the rail's mono count chip, the collection
 * facet's raw nids become node titles (collection pages link in with
 * ?collection=NID, so the value must stay the nid), and group order is
 * set by weight so the strongest facets lead the rail: coverage across
 * the 30k records is collection 91%, resource type 45%, language 12%,
 * SALDRU topic 5%, African country under 1%.
 */
function _saho_utils_archive_refine_alter(array &$form): void {
  // Keys are the filters' exposed identifiers, not their plugin ids.
  $weights = [
    'type' => -10,
    'collection' => -9,
    'language' => -8,
    'saldru' => -7,
    'country' => -6,
  ];
  foreach ($weights as $key => $weight) {
    if (isset($form[$key])) {
      $form[$key]['#weight'] = $weight;
    }
  }

  // Collection: a select of raw nids is useless to a person - name every
  // collection head, keeping the facet's count-descending order.
  if (isset($form['collection']['#options'])) {
    $nids = array_filter(array_keys($form['collection']['#options']), 'is_numeric');
    $titles = $nids === [] ? [] : \Drupal::database()->query(
      'SELECT nid, title FROM {node_field_data} WHERE nid IN (:nids[]) AND status = 1',
      [':nids[]' => $nids]
    )->fetchAllKeyed();
    foreach ($form['collection']['#options'] as $value => $label) {
      if (!is_numeric($value)) {
        $form['collection']['#options'][$value] = t('- All collections -');
        continue;
      }
      $count = preg_match('/\((\d+)\)\s*$/', (string) $label, $m)
        ? ' (' . number_format((int) $m[1]) . ')'
        : '';
      $form['collection']['#options'][$value] = ($titles[$value] ?? (string) $label) . $count;
    }
  }

  // Checkbox facets: restyle the trailing "(123)" into the rail's mono
  // count chip so the shipped register carries over unchanged.
  foreach (['type', 'language', 'saldru', 'country'] as $key) {
    if (!isset($form[$key]['#options'])) {
      continue;
    }
    foreach ($form[$key]['#options'] as $value => $label) {
      if (preg_match('/^(.*) \((\d+)\)$/s', (string) $label, $m)) {
        $form[$key]['#options'][$value] = Markup::create(
          Html::escape($m[1])
          . ' <span class="saho-facet-count">' . number_format((int) $m[2]) . '</span>'
        );
      }
    }
  }
}

/**
 * Implements hook_views_pre_view().
 */
function saho_utils_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  // /archives and /search: a keyword query ranks by relevance unless the
  // person picked a sort; without a query the register leads with recently
  // updated. Same rule, different keyword identifiers.
  $keyword_keys = [
    'saho_archive_search' => 'combine',
    'saho_global_search' => 'search_api_fulltext',
  ];
  $keyword_key = $keyword_keys[$view->id()] ?? NULL;
  if ($keyword_key !== NULL && $display_id === 'page_1') {
    $input = $view->getExposedInput();
    if (trim((string) ($input[$keyword_key] ?? '')) !== '' && empty($input['sort_by'])) {
      $input['sort_by'] = 'search_api_relevance';
      $input['sort_order'] = 'DESC';
      $view->setExposedInput($input);
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function saho_utils_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  // /places biography-category registers ("bio" URL param): places filtered
  // by who is connected to them. An EXISTS subquery instead of a views
  // relationship - a relationship LEFT JOINs the multi-value people field on
  // every query and multiplies each place into one row per connected person,
  // which DISTINCT cannot fully undo (the joined id lands in the SELECT).
  // Both views vary render cache on url.query_args via their exposed
  // filters, so the non-exposed param is cache-safe.
  if (!in_array($view->id(), ['places', 'places_map'], TRUE) || !$query instanceof Sql) {
    return;
  }
  // InputBag::get() throws on non-scalar input - read from all() instead.
  $bio = \Drupal::request()->query->all()['bio'] ?? NULL;
  if (!is_string($bio) || !ctype_digit($bio)) {
    return;
  }
  $query->addWhereExpression(0,
    "EXISTS (SELECT 1 FROM {node__field_people_related_tab} saho_bp
      JOIN {taxonomy_index} saho_bti ON saho_bti.nid = saho_bp.field_people_related_tab_target_id
      WHERE saho_bp.entity_id = node_field_data.nid
        AND saho_bp.deleted = 0
        AND saho_bti.tid = :saho_bio_tid)",
    [':saho_bio_tid' => (int) $bio]
  );
}

/**
 * Implements hook_theme().
 */
function saho_utils_theme($existing, $type, $theme, $path) {
  return [
    'register_grid_block' => [
      'variables' => [
        'register' => '',
        'items' => [],
        'block_title' => '',
        'intro_text' => '',
        'display_mode' => 'grid',
        'empty_text' => '',
      ],
      'template' => 'register-grid-block',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for views_view (africa_regional_pages).
 *
 * Moved here from the retired africa_regions module (#485): this is the
 * data path behind the /africa/* regional landing pages.
 */
function saho_utils_preprocess_views_view(&$variables) {
  $view = $variables['view'];

  // Only process our specific view.
  if ($view->id() !== 'africa_regional_pages') {
    return;
  }

  $display_id = $view->current_display;

  // Map displays to their country term IDs.
  $region_config = [
    'page_northern' => [
      'name' => 'Northern Africa',
      'country_tids' => [32464, 32481, 32495, 32501, 32514, 32518],
      'color' => 'deep-heritage-red',
    ],
    'page_eastern' => [
      'name' => 'Eastern Africa',
      'country_tids' => [32469, 32480, 32483, 32484, 32492, 32506, 32511, 32516, 32519],
      'color' => 'muted-gold',
    ],
    'page_central' => [
      'name' => 'Central Africa',
      'country_tids' => [32465, 32471, 32472, 32473, 32475, 32478, 32482, 32487],
      'color' => 'slate-blue',
    ],
    'page_western' => [
      'name' => 'Western Africa',
      'country_tids' => [
        32466, 32468, 32470, 32477, 32488, 32489, 32490, 32491,
        32494, 32498, 32499, 32504, 32505, 32508, 32510, 32517,
      ],
      'color' => 'faded-brick-red',
    ],
    'page_southern' => [
      'name' => 'Southern Africa',
      'country_tids' => [32467, 32474, 32493, 32496, 32497, 32500, 32502, 32503, 32512, 32515, 32520, 32521],
      'color' => 'deep-heritage-red',
    ],
  ];

  if (!isset($region_config[$display_id])) {
    return;
  }

  $current_region = $region_config[$display_id];
  $country_tids = $current_region['country_tids'];

  // Load country taxonomy terms.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $country_terms = $term_storage->loadMultiple($country_tids);

  $countries = [];
  $taxonomy_counter = \Drupal::service('saho_utils.taxonomy_counter');

  foreach ($country_terms as $term) {
    $count = $taxonomy_counter->countNodesByTerm(
      $term->id(),
      ['article', 'biography', 'archive', 'place'],
      ['field_african_country']
    );

    $countries[] = [
      'name' => $term->label(),
      'id' => $term->id(),
      'url' => $term->toUrl()->toString(),
      'count' => $count,
    ];
  }

  // Load featured places (limit to 4)
  $place_query = \Drupal::entityQuery('node')
    ->condition('type', 'place')
    ->condition('status', 1)
    ->condition('field_african_country', $country_tids, 'IN')
    ->accessCheck(FALSE)
    ->sort('changed', 'DESC')
    ->range(0, 4);

  $place_nids = $place_query->execute();
  $places = [];

  if ($place_nids) {
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $place_nodes = $node_storage->loadMultiple($place_nids);

    foreach ($place_nodes as $place) {
      $image_url = NULL;

      // Get place image.
      if ($place->hasField('field_place_image') && !$place->get('field_place_image')->isEmpty()) {
        $file = $place->get('field_place_image')->entity;
        if ($file && $file instanceof FileInterface) {
          $file_uri = $file->getFileUri();
          $image_url = \Drupal::service('file_url_generator')->generateString($file_uri);
        }
      }

      // Get country name.
      $country_name = '';
      if ($place->hasField('field_african_country') && !$place->get('field_african_country')->isEmpty()) {
        $country_ref = $place->get('field_african_country')->entity;
        if ($country_ref) {
          $country_name = $country_ref->label();
        }
      }

      $places[] = [
        'title' => $place->label(),
        'url' => $place->toUrl()->toString(),
        'image' => $image_url,
        'country' => $country_name,
      ];
    }
  }

  // Make data available to template.
  $variables['region_data'] = [
    'name' => $current_region['name'],
    'color' => $current_region['color'],
    'countries' => $countries,
    'places' => $places,
    'country_count' => count($countries),
  ];
}
