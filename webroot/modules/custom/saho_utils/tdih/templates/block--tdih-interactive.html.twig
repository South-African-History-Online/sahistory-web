{#
/**
 * @file
 * Template for the TDIH Interactive Block (Open Record 2027).
 *
 * A bordered catalogue aside: a mono header strip "This day in history - {date}",
 * ledger entries (square type marker + mono year + display title) separated
 * by hairlines, and a bottom timeline link. Square corners, hairline borders,
 * no shadows or gradients - styled by css/tdih-interactive.css with the
 * theme's Open Record tokens.
 *
 * Available variables:
 * - all_events: An array of node data for today's events (lead first).
 * - lead_event: The day's lead item (curated event preferred) or null.
 * - more_events: Up to four further items for the "Also on" ledger.
 * - date_picker_form: The form for selecting a date.
 * - display_mode: The display mode (compact or full).
 * - show_header_title / show_today_history / show_details_button /
 *   use_todays_date: Block configuration flags.
 *
 * JS contract (js/tdih-interactive.js) - do not rename:
 * .tdih-interactive-block, .tdih-today-history-wrapper, .tdih-event-item,
 * .tdih-event-title (a), .tdih-event-body.
 */
#}

<div class="tdih-interactive-block" role="region" aria-labelledby="tdih-heading">
  {% if show_header_title %}
    <h2 id="tdih-heading" class="tdih-block-strip">
      {{ 'This day in history'|t }} &middot; {{ "now"|date('j F') }}
    </h2>
  {% else %}
    <h2 id="tdih-heading" class="visually-hidden">{{ 'This day in history'|t }}</h2>
  {% endif %}

  <div class="tdih-block-body">
    <div class="tdih-today-history-wrapper" {% if not show_today_history %}style="display: none;"{% endif %}>
      {% if show_today_history and lead_event %}
        <div class="tdih-today-events">
          <h3 id="tdih-today-heading" class="visually-hidden">{{ 'Today in history'|t }}</h3>
          {# The lead card: the curated event (home page feature) when the
             day has one, its editor image, then the synopsis and the people
             in the event. The block guarantees lead_event.image is a real,
             existing file (saho_hero_mobile derivative). #}
          <div class="tdih-lead">
            {% if lead_event.image %}
              <a href="{{ lead_event.url }}" class="tdih-lead-figure" tabindex="-1" aria-hidden="true">
                <img
                  src="{{ lead_event.image }}"
                  alt=""
                  loading="lazy"
                  decoding="async"
                >
              </a>
            {% endif %}
            <a href="{{ lead_event.url }}" class="tdih-event-item tdih-entry tdih-entry--lead">
              <span class="tdih-entry-marker" aria-hidden="true"></span>
              <span class="tdih-entry-text">
                <span class="tdih-entry-year">{{ lead_event.event_date|date('Y') }}</span>
                <span class="tdih-event-title">{{ lead_event.title|striptags }}</span>
                {% if lead_event.synopsis %}
                  <span class="tdih-event-body tdih-lead-synopsis">{{ lead_event.synopsis }}</span>
                {% endif %}
              </span>
            </a>
            {% if lead_event.people %}
              <p class="tdih-lead-people">
                <span class="tdih-lead-people__label">{{ 'People'|t }}</span>
                {% for person in lead_event.people %}
                  <a href="{{ person.url }}" class="tdih-lead-people__link">{{ person.title }}</a>{% if not loop.last %}<span class="tdih-lead-people__sep" aria-hidden="true">&middot;</span>{% endif %}
                {% endfor %}
              </p>
            {% endif %}
          </div>

          {% if more_events %}
            <h3 class="tdih-more-heading">{{ 'Also on @date'|t({'@date': "now"|date('j F')}) }}</h3>
            <div class="tdih-entry-list tdih-entry-list--more">
              {% for item in more_events %}
                <a href="{{ item.url }}" class="tdih-event-item tdih-entry">
                  <span class="tdih-entry-marker" aria-hidden="true"></span>
                  <span class="tdih-entry-text">
                    <span class="tdih-entry-year">{{ item.event_date|date('Y') }}</span>
                    <span class="tdih-event-title">{{ item.title|striptags }}</span>
                    {% if display_mode != 'compact' and item.synopsis %}
                      <span class="tdih-event-body">{{ item.synopsis }}</span>
                    {% endif %}
                  </span>
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% elseif show_today_history %}
        <p class="tdih-no-events">{{ 'No events found for today.'|t }}</p>
      {% endif %}

      {# Editors can drop the link per block instance (show_more_link). #}
      {% if show_more_link %}
        <a href="/this-day-in-history" class="tdih-timeline-link">{{ 'View more events from this day'|t }} <span aria-hidden="true">&rarr;</span></a>
      {% endif %}
    </div>

    {# The birthday picker expands in place at the panel foot (R3 #478):
       a quiet mono invitation, not a form block. On instances that do
       NOT show the today-ledger (the /this-day-in-history page), the
       form and its default today results ARE the page's content, so the
       disclosure defaults open - a closed one left that page empty.
       picker_open (when set) overrides that heuristic: the event-node
       embed hides the ledger too but is an aside, not the page. #}
    {% if date_picker_form %}
      {% set birthday_open = picker_open is same as(null) ? not show_today_history : picker_open %}
      <details class="tdih-birthday-disclosure"{% if birthday_open %} open{% endif %}>
        <summary class="tdih-birthday-summary">{{ 'What happened on your birthday?'|t }} <span aria-hidden="true">&rarr;</span></summary>
        <div class="tdih-birthday-picker" role="search" aria-label="{{ 'Search historical events by date'|t }}">
          {{ date_picker_form }}
          {# A shared ?date=MM-DD link: that day's events, rendered server-side. #}
          {% if shared_date_events %}
            <div class="tdih-shared-date">{{ shared_date_events }}</div>
          {% endif %}
        </div>
      </details>
    {% endif %}

    {% if show_details_button and not use_todays_date %}
      <div class="tdih-footer">
        {% if all_events|length > 0 %}
          {% for item in all_events|slice(0, 1) %}
            <a href="{{ item.url }}" class="tdih-view-more-button">{{ 'Read more'|t }} <span aria-hidden="true">&rarr;</span></a>
          {% endfor %}
        {% else %}
          <a href="/this-day-in-history" class="tdih-view-more-button tdih-fallback-button">{{ 'View more events from this day'|t }} <span aria-hidden="true">&rarr;</span></a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
