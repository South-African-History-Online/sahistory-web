{#
/**
 * @file
 * Custom SAHO node template for Event (This day in history) content type.
 *
 * Title is handled globally and not rendered here.
 * Layout Builder is disabled - fields are output directly via Twig.
 */
#}

{# The rail renders only when it holds more than the date (see
   saho_preprocess_node__event); otherwise the record is one compact column. #}
{% set sidebar_has_content = event_has_rail or accordion_views is not empty %}
{# The event-record classes (and css/event-record.css) apply to the full
   record page only; other view modes share this template unstyled. #}
{% set event_classes = record is defined ? [
  'saho-article-wrapper',
  'saho-event-record',
  sidebar_has_content ? 'saho-event-record--rail' : 'saho-event-record--compact',
  event_dated ? 'saho-event-record--dated',
] : ['saho-article-wrapper'] %}

{# Related-cards footer renders .saho-button as static spans; ensure its CSS loads. #}
{{ attach_library('saho/saho-button') }}

<article{{ attributes.addClass(event_classes) }}>

  {# 2027 "Open Record" record header (typed tab + display ref + status + key fields). #}
  {% if record is defined %}
    {% set record_lead_mobile = (record_image.orientation is defined and record_image.orientation in ['portrait', 'square'] and not (node.hasField('field_feature_banner') and node.field_feature_banner.entity.uri.value)) ? record_image : {} %}
    {{ include('saho:saho-record-header', {
      type: record.type,
      reference: record.reference,
      status: record.status,
      kicker: record.kicker,
      title: record.title,
      facts: record.facts,
      image: record_lead_mobile,
    }, with_context = false) }}
  {% endif %}

  {# The record toolbar rides directly under the key-field strip (R3 #476). #}
  {% if record_toolbar is defined %}
    {{ include('saho:saho-record-toolbar', record_toolbar, with_context = false) }}
  {% endif %}

  <div class="saho-article-grid">

    {# LEFT: Main content column #}
    <div class="saho-main-content">

      {# field_feature_banner does not exist on the event bundle (config/sync:
         article/biography/place only), so the old banner branch was dead. The
         lead image is the Open Record duotone image-credit figure (S3). #}
      {# Image + text travel together: in the compact layout a small or upright
         image sits beside the text (event_image_placement = aside), a wide
         one leads above it. #}
      <div class="saho-event-lead saho-event-lead--{{ event_image_placement|default('none') }}">
        {% if record_image.src is defined and record_image.src %}
          {{ include('saho:saho-image-credit', record_image, with_context = false) }}
        {% endif %}

        {# The event date leads the record header as its kicker. #}

        {# Main content with ID for TOC linking #}
        <div id="event-details" class="saho-article-body">
          {% if content.body %}
            {# Remove the label by accessing the content directly #}
            {{ content.body.0 }}
          {% endif %}
        </div>
      </div>

      {% if content.field_highlight %}
        <div id="highlights" class="saho-highlight">
          <h3>{{ 'Highlights'|t }}</h3>
          {{ content.field_highlight }}
        </div>
      {% endif %}

      {# Render remaining fields not already shown manually #}
      {{ content|without(
        'body',
        'field_highlight',
        'field_further_reading',
        'field_event_image',
        'field_tdih_image',
        'field_node_image_caption',
        'field_ref_str',
        'field_feature_banner',
        'field_feature_parent',
        'field_feature_tag',
        'field_home_page_feature',
        'field_event_date',
        'field_annual',
        'field_event_type',
        'field_people_related_tab',
        'field_organizations_related_tab',
        'field_topics_related_tab',
        'field_timelines_related_tab',
        'field_synopsis',
        'field_article_author',
        'field_article_editors',
        'sharing_buttons',
        'comment_node_event'
      ) }}

      {# Provenance: "How we know this" from field_ref_str (S3). #}
      {% if record_provenance %}
        {{ include('saho:saho-provenance-block', record_provenance, with_context = false) }}
      {% endif %}

      {# Cite this entry (Harvard / APA / Oxford, from CitationService). #}
      {% if record_citation %}
        {{ include('saho:saho-citation', record_citation, with_context = false) }}
      {% endif %}

      {# The record foot (R3 #480/#477): one quiet supporter line, then
         reader contributions - after the record, never inside it. #}
      {# Open Record reading list: derived related records (siblings, shared
         topics, popular) - the record's onward-reading engine. #}
      {# Other events sharing this day and month - the onward read that fits a
         this-day-in-history entry. #}
      {% if event_same_day %}
        <section class="saho-event-sameday" aria-labelledby="event-sameday-heading">
          <h2 class="saho-event-sameday__title" id="event-sameday-heading">{{ 'Also on @date'|t({'@date': event_same_day.label}) }}</h2>
          <ol class="saho-event-sameday__list">
            {% for item in event_same_day.items %}
              <li class="saho-event-sameday__item">
                <span class="saho-event-sameday__year">{{ item.year }}</span>
                <a class="saho-event-sameday__link" href="{{ item.url }}">{{ item.title }}</a>
              </li>
            {% endfor %}
          </ol>
        </section>
      {% endif %}

      {% if record_reading %}
        {{ include('saho:saho-reading-list', { title: 'Further reading'|t, items: record_reading }, with_context = false) }}
      {% endif %}

      {# The date search follows the record and its sources, never splits them. #}
      {% if tdih_minimal_block %}
        <div class="saho-tdih-minimal-block mt-4">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
              <h4 class="h6 mb-3 text-muted">
                <i class="fas fa-search me-2"></i>
                {{ 'Search events by date'|t }}
              </h4>
              {{ tdih_minimal_block }}
            </div>
          </div>
        </div>
      {% endif %}

      <p class="saho-record-support">
        {{ 'SAHO is free because readers fund it.'|t }}
        <a href="/donate">{{ 'Donate'|t }} &rarr;</a>
      </p>
      {{ content.comment_node_event ?? '' }}

    </div>

    {# RIGHT: Sidebar (the Open Record rail - S3) #}
    {# No field_feature_banner on events, so the lead image always stays in the
       main column - there is no rail-image branch to gate here. #}
    {% if sidebar_has_content %}
    <aside class="saho-article-sidebar">

      {# Event record: the structured event fields. #}
      {% if record_meta %}
        {{ include('saho:saho-metadata-block', record_meta, with_context = false) }}
      {% endif %}

      {# Cross-references: typed entity relations. #}
      {% if record_related %}
        {{ include('saho:saho-related-tabs', record_related, with_context = false) }}
      {% endif %}

      {# Further reading (kept crawlable). #}
      {% if record_further %}
        <section class="saho-meta-block saho-meta-block--event">
          <h2 class="saho-meta-block__title">{{ 'Further reading'|t }}</h2>
          <div class="saho-meta-block__val">{{ record_further }}</div>
        </section>
      {% endif %}

      {# References now render as the main-column provenance-block (S3). #}

    </aside>
    {% endif %}

  </div>

</article>

